{
  "name": "kwsx-client",
  "version": "1.0.0",
  "description": "internet radio for all",
  "license": "ISC",
  "author": "sharp",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "test": "echo \"Error: no test specified\" && exit 1",
